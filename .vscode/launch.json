  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch and Debug Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "autoReload": {
          "enable": true
      },
    },
    {
      "name": "task: history_to_match_list",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/history_to_match_list.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "autoReload": {
          "enable": true
      },
    },
    {
      "name": "task: generate_first_match_to_show_fixtures",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_first_match_to_show_fixtures.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "autoReload": {
          "enable": true
      },
    }
  ]
}